<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime exceptions for V8's JIT, in Electron and in the runtime's Node.
     No disable-library-validation: a Developer ID build signs every native module with the app's team. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Calls with the Chief: the hardened runtime blocks the microphone without it. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>

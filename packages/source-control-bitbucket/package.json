{
  "name": "@caveman-app/source-control-bitbucket",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    "./client/definition": {
      "types": "./src/client/definition.ts",

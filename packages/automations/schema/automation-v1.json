{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caveman.so/schemas/automation-v1.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "enum": [
        1
      ]
    },
    "host": {
      "type": "string",
      "enum": [
        "this-mac",
        "cloud"
      ],
      "description": "Where its triggers fire: this-mac (default; Caveman Code on the computer with the repository) or cloud (on Cloud computers)."
    },
    "description": {
      "type": "string",
      "description": "One line: what it does."
    },
    "on": {
      "type": "object",
      "properties": {
        "github": {
          "type": "object",
          "properties": {
            "event": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "issues.opened",
                    "issues.labeled",
                    "pull_request.opened",
                    "pull_request.synchronize",
                    "issue_comment.created",
                    "push",
                    "workflow_run.completed",
                    "pull_request.labeled",
                    "pull_request.closed",
                    "check_suite.completed"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "issues.opened",
                      "issues.labeled",
                      "pull_request.opened",
                      "pull_request.synchronize",
                      "issue_comment.created",
                      "push",
                      "workflow_run.completed",
                      "pull_request.labeled",
                      "pull_request.closed",
                      "check_suite.completed"
                    ]
                  }
                }
              ]
            },
            "label": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Only issues or pull requests with one of these labels."
            },
            "paths": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Only pushes and pull requests that change a file matching one of these globs."
            },
            "branches": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Only these branches."
            },
            "actors": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "any"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "owner",
                      "member",
                      "collaborator"
                    ]
                  }
                }
              ],
              "description": "Who may fire it, by GitHub author association. Default: owner, member, collaborator."
            },
            "mention": {
              "type": "boolean",
              "description": "issue_comment.created: only comments that mention @caveman."
            },
            "conclusion": {
              "type": "string",
              "enum": [
                "failure",
                "success",
                "cancelled",
                "timed_out"
              ],
              "description": "workflow_run.completed and check_suite.completed: only runs that ended this way."
            },
            "merged": {
              "type": "boolean",
              "description": "pull_request.closed: only pull requests that were merged (true) or closed unmerged (false)."
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false,
          "title": "GitHub trigger"
        },
        "schedule": {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "description": "A 24-hour time of day, quoted: \"09:00\"."
            },
            "timezone": {
              "type": "string",
              "description": "An IANA time zone, like Europe/Amsterdam. Required with at, once, cron, start and until."
            },
            "weekdays": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ]
              },
              "description": "Days for at; every day when absent."
            },
            "monthdays": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31
                  },
                  {
                    "type": "string",
                    "enum": [
                      "last"
                    ]
                  }
                ]
              },
              "description": "Days of the month for at, 1 to 31 or last. A month without the day skips it; last is always its last day."
            },
            "every": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(s|m|h|d|w)$",
              "description": "Alone, an interval of at least 5m (s, m or h). With at, every Nth day (2d) or, with weekdays, every Nth week (2w), counted from start."
            },
            "once": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ]([01][0-9]|2[0-3]):[0-5][0-9]$",
              "description": "A date and 24-hour time in timezone, quoted: \"2026-11-09 09:00\". Runs once."
            },
            "cron": {
              "type": "string",
              "description": "A five-field cron expression read in timezone, like \"0 9 * * 1-5\"; L is a month's last day."
            },
            "start": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "The first day it may run, in timezone, quoted: \"2026-11-09\". Every 2d or 2w counts from it."
            },
            "until": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "The last day it may run, in timezone, quoted: \"2026-12-31\"."
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Stop after this many scheduled runs; runs by hand do not count."
            }
          },
          "additionalProperties": false,
          "title": "Schedule trigger"
        },
        "webhook": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "A signed request to the automation's URL."
        },
        "slack": {
          "type": "object",
          "properties": {
            "mention": {
              "type": "boolean",
              "enum": [
                true
              ],
              "description": "A message that mentions @caveman (the only Slack event so far)."
            },
            "channels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Only these channels, by name (#triage) or id; every channel the app is in when absent."
            }
          },
          "additionalProperties": false,
          "title": "Slack trigger",
          "description": "A Slack message that mentions @caveman (host: cloud)."
        },
        "linear": {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "issue.created",
                  "issue.labeled",
                  "comment.mention"
                ]
              },
              "description": "issue.created, issue.labeled, comment.mention; all three when absent."
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Only issues with one of these labels."
            },
            "team": {
              "type": "string",
              "description": "Only this team's issues, by key (ENG)."
            }
          },
          "additionalProperties": false,
          "title": "Linear trigger",
          "description": "A Linear issue created or labelled, or a comment that mentions @caveman (host: cloud)."
        },
        "jira": {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "issue.created",
                  "issue.labeled"
                ]
              },
              "description": "issue.created, issue.labeled; both when absent."
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Only issues with one of these labels."
            },
            "project": {
              "type": "string",
              "description": "Only this project's issues, by key (OPS)."
            }
          },
          "additionalProperties": false,
          "title": "Jira trigger",
          "description": "A Jira issue created or labelled (host: cloud)."
        }
      },
      "additionalProperties": false,
      "description": "What starts a run. Running it by hand always works."
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "Values a manual run asks for."
    },
    "budget": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\$?[0-9]+(\\.[0-9]{1,2})?$",
          "description": "Dollars: $6 or $1.50."
        },
        {
          "type": "object",
          "properties": {
            "usd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tokens": {
              "type": "integer",
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            "turns": {
              "type": "integer",
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "The most one run may spend, across every step and attempt: $6, or { usd, tokens, turns }."
    },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string",
            "description": "The agent that does this step: .caveman/agents/<name>.md, .claude/agents, ~/.caveman/agents or a built-in."
          },
          "prompt": {
            "type": "string",
            "description": "Instructions for this step, instead of an agent."
          },
          "if": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Run only when earlier steps decided these values (all must hold), e.g. { triage: implement }. A value is one of that step's decides, or failed."
          },
          "decides": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,39}$",
              "description": "A decision: lowercase letters, digits, - and _."
            },
            "description": "For a prompt or run step: the values its decision may take, like [news, quiet]. A run step's command prints decision: <value> as its last line. An agent's decides live in its file."
          },
          "model": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "fast",
                  "base",
                  "frontier"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "haiku",
                  "sonnet",
                  "opus"
                ]
              },
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9.-]*\\/[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                "description": "A pinned model: provider/model."
              }
            ],
            "description": "auto (Caveman Auto picks per turn), a class (fast, base, frontier), or a pin like anthropic/claude-sonnet-5-5."
          },
          "effort": {
            "type": "string",
            "enum": [
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "description": "How hard the model thinks."
          },
          "escalate": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "fast",
                  "base",
                  "frontier"
                ],
                "description": "A model class, resolved where the step runs: fast, base or frontier."
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "model": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "auto",
                            "fast",
                            "base",
                            "frontier"
                          ]
                        },
                        {
                          "type": "string",
                          "enum": [
                            "haiku",
                            "sonnet",
                            "opus"
                          ]
                        },
                        {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9.-]*\\/[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                          "description": "A pinned model: provider/model."
                        }
                      ],
                      "description": "auto (Caveman Auto picks per turn), a class (fast, base, frontier), or a pin like anthropic/claude-sonnet-5-5."
                    },
                    "engine": {
                      "type": "string",
                      "description": "Another engine for this rung: caveman, claude-agent, codex, or acp:<id>."
                    },
                    "effort": {
                      "type": "string",
                      "enum": [
                        "minimal",
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "title": "Escalation rung"
                }
              }
            ],
            "description": "What later attempts run on: a class for attempts 2 and later, or a ladder like [{ model: frontier }, { engine: codex }] (attempt 2 the first rung, 3 the next; the last one repeats)."
          },
          "computer": {
            "type": "string",
            "enum": [
              "none",
              "code",
              "readonly",
              "full"
            ],
            "description": "none: no checkout. code: no checkout; runs JavaScript programs over its tools. readonly (default): a copy at the run's commit; changes are discarded. full: the run's worktree; changes are committed."
          },
          "checks": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "A command the runtime runs in the step's computer; exit 0 passes."
                },
                {
                  "type": "object",
                  "properties": {
                    "agent": {
                      "type": "string",
                      "description": "An agent that decides approve or request_changes."
                    }
                  },
                  "required": [
                    "agent"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "description": "Run by the runtime after the agent finishes, in order; the first failure fails the attempt."
          },
          "retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "More attempts after the first when checks fail: 0 to 3."
          },
          "timeout": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(s|m|h)$",
            "description": "Per attempt, checks included. Default 30m for full, 10m otherwise; at most 2h, the run's deadline."
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Steps that must finish first. A file where any step has needs runs as a graph: a step starts once its needs succeeded, beside others that are ready."
          },
          "parallel": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4,
            "description": "Attempts at once, each in its own copy: 2 to 4. Needs at least one check."
          },
          "pick": {
            "type": "string",
            "enum": [
              "first",
              "best"
            ],
            "description": "With parallel: first (the first attempt that passes its checks) or best (every passing attempt, then a reviewer picks)."
          },
          "approve": {
            "type": "object",
            "properties": {
              "by": {
                "type": "string",
                "enum": [
                  "owner",
                  "members"
                ],
                "description": "owner: the automation's owner. members: anyone in the org who may write to the repository."
              },
              "timeout": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(s|m|h)$",
                "description": "How long the run waits for an answer: default 72h, at most 336h (14 days)."
              }
            },
            "required": [
              "by"
            ],
            "additionalProperties": false,
            "description": "After the step succeeds, the run waits until a person approves it; its outputs and the steps after it wait too."
          },
          "wait": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(s|m|h)$",
            "description": "A step that only waits this long (at most 168h); the wait survives restarts."
          },
          "run": {
            "type": "string",
            "minLength": 1,
            "description": "A command the runtime runs in the step's computer, with no model; exit 0 succeeds."
          },
          "outcome": {
            "type": "object",
            "properties": {
              "rubric": {
                "type": "string",
                "minLength": 1,
                "description": "What a finished step must meet, in words. A separate grader scores the work against it."
              },
              "max_iterations": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Times the step may run to meet the rubric, with the grader's feedback each time: 1 to 5, default 2."
              }
            },
            "required": [
              "rubric"
            ],
            "additionalProperties": false,
            "description": "After the checks pass, a grader scores the step against a rubric; work that falls short goes back with its feedback."
          }
        },
        "additionalProperties": false,
        "title": "Step"
      },
      "description": "Steps run one at a time in file order; once any step has needs, they run as a graph, each when its needs are done."
    },
    "outputs": {
      "type": "object",
      "properties": {
        "github.comment": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*\\.[A-Za-z_][A-Za-z0-9_]*$",
              "description": "<step>.<field>, like review.summary."
            },
            {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                }
              },
              "required": [
                "from"
              ],
              "additionalProperties": false
            }
          ],
          "description": "One comment on the issue or pull request, edited by later runs."
        },
        "github.pull_request": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string"
            },
            "draft": {
              "type": "boolean"
            }
          },
          "required": [
            "from"
          ],
          "additionalProperties": false,
          "description": "A pull request from the run's branch. Its step must be computer: full."
        },
        "slack.message": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*\\.[A-Za-z_][A-Za-z0-9_]*$",
              "description": "<step>.<field>, like review.summary."
            },
            {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                },
                "channel": {
                  "type": "string"
                }
              },
              "required": [
                "from"
              ],
              "additionalProperties": false
            }
          ],
          "description": "A Slack message: a reply in the thread that fired the run, or a post in channel. Cloud posts it (host: cloud)."
        },
        "linear.comment": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*\\.[A-Za-z_][A-Za-z0-9_]*$",
              "description": "<step>.<field>, like review.summary."
            },
            {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                }
              },
              "required": [
                "from"
              ],
              "additionalProperties": false
            }
          ],
          "description": "A comment on the Linear issue that fired the run. Cloud posts it (host: cloud)."
        },
        "jira.comment": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*\\.[A-Za-z_][A-Za-z0-9_]*$",
              "description": "<step>.<field>, like review.summary."
            },
            {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                }
              },
              "required": [
                "from"
              ],
              "additionalProperties": false
            }
          ],
          "description": "A comment on the Jira issue that fired the run. Cloud posts it (host: cloud)."
        },
        "chief": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string",
              "minLength": 1,
              "description": "The Chief it reports to, by id. Absent, or that Chief gone: a Chief that works in the project."
            }
          },
          "required": [
            "from"
          ],
          "additionalProperties": false,
          "description": "Hands the step's summary to a Chief (to, else one that works in the project): its routine's row shows it, and a run that decided news wakes the Chief with it."
        }
      },
      "additionalProperties": false,
      "description": "What the runtime writes when the run ends. Agents hold no token for these."
    }
  },
  "required": [
    "steps"
  ],
  "additionalProperties": false,
  "title": "Caveman automation",
  "description": "A Caveman automation: steps, triggers, checks and outputs. https://caveman.so/docs/automations"
}
